PORT=4000
# Adresse(s) du frontend, séparées par des virgules (CORS + redirections après paiement)
CLIENT_URL=http://localhost:5173
# Firebase Admin : chemin vers la clé de service, relatif au dossier backend (NE PAS commiter)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Paiement : "konnect" (par défaut) ou "mock" (paiement simulé, pour les démonstrations)
PAYMENT_PROVIDER=konnect
# Konnect (mode sandbox)
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_BASE=https://api.sandbox.konnect.network/api/v2
PUBLIC_API_URL=http://localhost:4000

# Secret servant à hacher les codes de vérification e-mail (mettre une longue chaîne aléatoire)
CODE_SECRET=
# E-mails (SMTP). Sans SMTP, hors production, le code est affiché dans le terminal du backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
